&RUN_PARAMS
cosmo=.false.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nremap=100000
nsubcycle=1,1,2,2
ncontrol=1
rt=.true.
verbose=.false.
cost_weighting=.false.
nstepmax=1
static=.true.
/
&OUTPUT_PARAMS
foutput=100
!delta_tout=0.067045
!tend=0.67045
!delta_tout=0.0670814
tend=13.4162814
cpu_time_limit=24.0
/
&INIT_PARAMS
filetype='ascii'
initfile(1)='/data80/currodri/isolated_rtzdust/lib/IC_G8/'
/
&AMR_PARAMS
levelmin=3
levelmax=3    ! 14=9 pc
ngridmax=1000 ! 180000 should be very very close to the max available on cosma8 for full node usage
npartmax=8000000
boxlen=1d-1
/
&POISSON_PARAMS 
epsilon=1e-4
cic_levelmax=14
/
&BOUNDARY_PARAMS
nboundary=6
bound_type= 2, 2,  2,  2,  2,  2
ibound_min=-1, 1, -1, -1, -1, -1
ibound_max=-1, 1,  1,  1,  1,  1
jbound_min= 0, 0, -1,  1, -1, -1
jbound_max= 0, 0, -1,  1,  1,  1
kbound_min= 0, 0,  0,  0, -1,  1
kbound_max= 0, 0,  0,  0, -1,  1
/
&HYDRO_PARAMS
gamma=1.666667 
courant_factor=0.8
slope_type=1
pressure_fix=.true.
beta_fix=0.5
riemann='hllc'
scheme='muscl'
temperature_save_ivar=2
cooling_time_ivar=1
coolheat_save_ivar=3
/
&PHYSICS_PARAMS
haardt_madau=.false.
self_shielding=.true.
cooling=.true.
cloudy_metal_cooling=.false.
cloudy_metal_file="../lib/cloudy_metal_HM12_z.bin"
os13_metal_cooling=.false.
os13_cooling_dir="../lib/ion_cooling_tables/"
fs_cooling_dir="~/ramses/ramses-cgm/data/fine_structure_data/"
htmc_metal_cooling=.true.
htmc_cooling_dir="~/ramses/ramses-cgm/data/high_T_ion_cooling_tables/"
neq_chem=.true.
metal=.true.
simple_ode=.true.
oxygen_ions=.true.
nitrogen_ions=.true.
carbon_ions=.true.
magnesium_ions=.true.
silicon_ions=.true.
sulfur_ions=.true.
iron_ions=.true.
neon_ions=.true.
z_ave=1.d0 ! 1/10 solar
n_star=10.
t_star=1.632456
T2_star=15.
g_star=1.0
jeans_ncells=-1
n_gmc=10.d20
!taysun added:
nsn2mass=20
fstar_min=-1
mechanical_feedback=.true.
mechanical_geen=.true.
t_sne=50.
M_SNII=20.
eta_sn=0.2 !Kroupa
sn2_real_delay=.false.
star_maker='FK2'
star_imf='kroupa'
log_mfb=.true.
sf_lam=1 ! allow star formation if lamjt < 2
use_initial_mass=.true.
eta_sn=0.2     ! Kroupa
snIa_mech=.true.
!oscaar params
oscaar_feedback=.true.
oscaar_real_delay=.true.
f_w=0.
!eta_sn=0.1
SNenergy=1.0d51
Tmax=1.0d9
vmaxFB=6000.00
maxadvfb=6000.0
smallT=1.e0
fbsafety=.true.
Nrcool=6.0
supernovae=.false.
winds=.true.
momentum=.true.
energy=.true.
metalscaling=.true.
SNIamodel=1      !DTD, t^-1.12
Ia_rate=2.6d-13  !Field DTD
yields_portinari=.false.
yields_lc18=.true.
yields_lc18_dir='~/ramses/ramses-cgm/data/yields/Limongi_Chieffi_2018/'
no_metal_update=.true.
init_metal_ions_all_ionized=.false.
SNdiagnostics=.false.
SFdiagnostics=.false.
! Dust parameters
dust=.true.
dust_log=.false.
dust_sputtering=.true.
dust_accretion=.true.
dust_acc_coulomb=.false.
dust_coagulation=.true.
dust_shattering=.true.
dust_ratd=.false.
H2ondust=.true.
GDinit=-1d0
fpah_ini=-1d0
fsmall_ini=0.01d0
nhmax_acc=1d4,1d4,1d4,1d4
dust_SNdest=.true.
dust_inSN=.true.
sticking_coef='subgrid'
coagulation_dispersion='subgrid'
shattering_dispersion='subgrid'
thermal_sputtering='nozawa2006'
dust_SNdest_eff=0.15,0.15d0,0.10d0,0.10d0
Coulomb_enhance=1d0,1d0,1d0,1d0!1.0d0,1.0d-5,10.0d0,1.0d0
nh_coa=1d1,1d1,1d1,1d1
nhmax_coa=1d6,1d6,1d6,1d6
asize=0.005d0,0.1d0,0.005d0,0.1d0
sgrain=2.2d0,2.2d0,3.3d0,3.3d0
t_sputter_ref=2.5d4!1d5
t_growth_ref=3.69475795d6!3.69475795d5
Sconstant=0.333333333d0  ! sticking coef=1/3
t_sha_ref=7.5730229d5
t_coa_ref=9.4662786d5
fixed_rad_ani=1d-1
fixed_lambda_mean=5d-1
! PAH parameters
dust_pahs=.true.
dust_small_shattering=.false.
pah_coagulation=.true.
pah_accretion=.true.
pah_acc_coulomb=.false.
sticking_coef_pah='subgrid'
pah_sputtering=.true.
pah_uv_destruction=.true.
pah_sn_destruction=.true.
sublimation_model='Murga2019'
H2onpah=.true.
pah_Coulomb_enhance=1d0
pah_nhmax_acc=1d4
pah_nh_coa=-1
pah_nhmax_coa=1d6
! Dust optics
dust_tables_dir="../"
/
&REFINE_PARAMS
mass_sph=1d-6  ! 1000 solar masses = 1.666 stellar particle masses.
m_refine=30*8. ! Use 8 particles for med, 3 for low
! Allow refinement only on oxygen-enriched gas
ivar_refine=8
var_cut_refine=1e-4
interpol_type=0
interpol_var=1
jeans_refine=20*4.0
/
&MERGER_PARAMS
rad_profile='exponential'
z_profile='gaussian'
gal_center1=0.0,0.0,0.0
gal_center2=1d5,1d5,1d5 ! Well outside the box
Mgas_disk1=0.171951
Mgas_disk2=0d0
typ_radius1=0.686436
typ_radius2=0.686436
cut_radius1=5.01098 
cut_radius2=5.01098 
typ_height1=0.0686436
typ_height2=0.0686436
cut_height1=0.288303 
cut_height2=0.288303 
IG_density_factor=1d0
Vcirc_dat_file1='/data80/currodri/isolated_rtzdust/lib/IC_G8/Vcirc.dat'
Vcirc_dat_file2='/data80/currodri/isolated_rtzdust/lib/IC_G8/Vcirc.dat'
ic_part_file_gal1='ic_part'
ic_part_file_gal2='ic_part'
gal_axis1=0,0,1
gal_axis2=0,0,1
Vgal1=0.0,0.0,0.0
Vgal2=0.0,0.0,0.0
/
&RT_PARAMS
X=7.6d-1
Y=2.4d-1
rt_is_init_xion=.false.
rt_isIR=.true.
rt_isIRtrap=.true.
rt_isoPress=.true.
rt_smooth=.true.
SED_isEgy=.true.
rt_output_coolstats=.true.
rt_star=.false.
rt_otsa=.true.
sed_dir='/data80/currodri/isolated_rtzdust/lib/bpass_v221_135_100'
!sedprops_update=10
rt_esc_frac=1.0        ! we may calibrate this for sensible reionisation
rt_nsubcycle=500
rt_c_fraction=0.01
rt_flux_scheme='glf'
isHe=.true.
isH2=.true.
isH2Katz=.true.
isCO=.true.
H2clumping=1.d0
LWgroup = 4 
T_sputter=1.d6
rt_T_sputter=1.d6
include_collisional_ionization=.true.
include_photoionisation=.true.
include_charge_transfer=.true.
include_grain_recombination=.true.
include_cosmic_ray_ionization=.true.
include_cosmic_ray_heating=.true.
include_dust_heat_cool=.true.
UV_background_G0=1.d0 !1.d0 !0.0070977d0
low_t_noneq_cooling=.true.
metal_cooling_catastrophe_fix=.false.
metal_cooling_catastrophe_rho=0.005d0
simple_dust_depletion=.false.
!Ha, Hb, O3_5007, O3_4959, O3_4363, O2_3726, O2_3728, N2_6583
!el_movie_vars= 1, 1, 1, 1, 1, 1, 1, 1
uvbg_rtz=.false.
/
&RT_GROUPS
kappaAbs      = 0.0,  1d3,   1d3,   1d3,   1d3,   1d3,    1d3,    1d3     
kappaSc       = 5.0,    0,     0,     0,     0,     0,      0,      0       
group_egy     = 0.1,  1.0,  7.61, 12.27, 14.32, 17.50, 28.985, 65.106
groupL0       = 0.1,  1.0,  5.60, 11.20, 13.60, 15.20, 24.590, 54.420
groupL1       = 1.0,  5.6, 11.20, 13.60, 15.20, 24.59, 54.420, 1000.000
spec2group    = 4,5,6,7             ! H2, HI, HeI, HeII -> pck  
/
